+// SM75 native GDN chunk output kernel (chunk_fwd_o) with fp16 WMMA.
+//
+// Replaces the FLA Triton kernel, whose tl.dot lowers to SIMT on SM75 and runs
+// at ~1.45 TFLOPS. One CTA per (chunk, value head, value half). The chunk is
+// BT=64 rows, K=128 key dims, V=128 value dims; a CTA computes
+//   S = q k^T                     [64, 64]  fp32 accumulators
+//   O1 = q h^T                    [64, 64]  fp32 accumulators (pre-chunk state)
+//   A[i][j] = S[i][j] exp(g_i-g_j) with j <= i      (chunk-local decay, causal)
+//   O = scale * (exp(g_i) O1 + A v)
+// Outputs fp16. Varlen: cu_seqlens + chunk_indices; chunk h is indexed by the
+// global chunk counter, matching chunk_o.py.
+#include <ATen/core/Tensor.h>
+#include <ATen/ops/empty.h>
+#include <ATen/ops/empty_like.h>
+#include <c10/cuda/CUDAException.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cmath>
+#include <cuda_fp16.h>
+#include <mma.h>
+#include <torch/library.h>
+
+namespace {
+namespace wmma = nvcuda::wmma;
+constexpr int BT = 64;    // chunk rows
+constexpr int KD = 128;   // key dim
+constexpr int VD = 128;   // value dim
+constexpr int VH = 64;    // value dims per CTA
+constexpr int THREADS = 256;
+constexpr int QS = 64 + 8;   // padded shared row stride (halves)
+constexpr int TS = 64 + 4;   // padded temp row stride (floats)
+
+using Acc = wmma::fragment<wmma::accumulator, 16, 16, 16, float>;
+using AR = wmma::fragment<wmma::matrix_a, 16, 16, 16, __half, wmma::row_major>;
+using BC = wmma::fragment<wmma::matrix_b, 16, 16, 16, __half, wmma::col_major>;
+using BR = wmma::fragment<wmma::matrix_b, 16, 16, 16, __half, wmma::row_major>;
+
+struct Params {
+  const __half *q, *k, *v, *h;
+  const float *g;
+  __half *o;
+  const int32_t *cu;
+  const int32_t *chunk_indices;
+  int H, Hg;
+  float scale;
+  int64_t qt, qh, kt, kh, vt, vh, ot, oh, ht, hh, hv, gt, gh;
+};
+
+struct __align__(16) Shared {
+  __half q[BT][QS];   // q tile, later reused for A
+  __half k[BT][QS];   // k tile, later reused for v
+  __half h[VH][QS];   // state tile for this value half
+  float temp[BT][TS]; // S, then O1, then O2
+  float gs[BT];
+};
+
+__global__ void __launch_bounds__(THREADS) o_kernel(Params p) {
+  extern __shared__ char smem[];
+  auto &s = *reinterpret_cast<Shared *>(smem);
+  const int chunk = blockIdx.x;
+  const int head = blockIdx.y >> 1, vh = blockIdx.y & 1;
+  const int seq = p.chunk_indices[2 * chunk];
+  const int i_t = p.chunk_indices[2 * chunk + 1];
+  const int bos = p.cu[seq], eos = p.cu[seq + 1];
+  const int row0 = bos + i_t * BT;
+  const int rows = min(BT, eos - row0);
+  const int key_head = head / (p.H / p.Hg);
+  const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+  const int tid = threadIdx.x;
+
+  for (int x = tid; x < BT; x += THREADS)
+    s.gs[x] = x < rows ? p.g[int64_t(row0 + x) * p.gt + head * p.gh] : 0.f;
+  __syncthreads();
+
+  Acc sacc[2], oacc[2], o2acc[2];
+#pragma unroll
+  for (int i = 0; i < 2; ++i) {
+    wmma::fill_fragment(sacc[i], 0.f);
+    wmma::fill_fragment(oacc[i], 0.f);
+    wmma::fill_fragment(o2acc[i], 0.f);
+  }
+
+  for (int kb = 0; kb < KD; kb += 64) {
+    for (int x = tid; x < BT * 64; x += THREADS) {
+      const int row = x >> 6, kk = x & 63;
+      const bool ok = row < rows;
+      s.q[row][kk] =
+          ok ? p.q[int64_t(row0 + row) * p.qt + key_head * p.qh + kb + kk]
+             : __float2half_rn(0.f);
+      s.k[row][kk] =
+          ok ? p.k[int64_t(row0 + row) * p.kt + key_head * p.kh + kb + kk]
+             : __float2half_rn(0.f);
+    }
+    for (int x = tid; x < VH * 64; x += THREADS) {
+      const int vv = x >> 6, kk = x & 63;
+      s.h[vv][kk] =
+          p.h[(int64_t(chunk) * p.H + head) * p.hh + (vh * VH + vv) * p.hv +
+              kb + kk];
+    }
+    __syncthreads();
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+      const int tile = warp + 8 * i, m = tile >> 2, n = tile & 3;
+#pragma unroll
+      for (int kk = 0; kk < 64; kk += 16) {
+        AR a;
+        BC bs, bo;
+        wmma::load_matrix_sync(a, &s.q[m * 16][kk], QS);
+        wmma::load_matrix_sync(bs, &s.k[n * 16][kk], QS);
+        wmma::load_matrix_sync(bo, &s.h[n * 16][kk], QS);
+        wmma::mma_sync(sacc[i], a, bs, sacc[i]);
+        wmma::mma_sync(oacc[i], a, bo, oacc[i]);
+      }
+    }
+    __syncthreads();
+  }
+
+  // S -> temp, then build A (decay + causal, rows masked) into the q tile.
+#pragma unroll
+  for (int i = 0; i < 2; ++i) {
+    const int tile = warp + 8 * i, m = tile >> 2, n = tile & 3;
+    wmma::store_matrix_sync(&s.temp[m * 16][n * 16], sacc[i], TS,
+                            wmma::mem_row_major);
+  }
+  __syncthreads();
+  for (int x = tid; x < BT * BT; x += THREADS) {
+    const int i = x >> 6, j = x & 63;
+    float a = 0.f;
+    if (i < rows && j < rows && j <= i)
+      a = s.temp[i][j] * __expf(s.gs[i] - s.gs[j]);
+    s.q[i][j] = __float2half_rn(a);
+  }
+  // v tile into the k buffer.
+  for (int x = tid; x < BT * VH; x += THREADS) {
+    const int row = x / VH, vv = x % VH;
+    s.k[row][vv] = row < rows
+                       ? p.v[int64_t(row0 + row) * p.vt + head * p.vh +
+                             vh * VH + vv]
+                       : __float2half_rn(0.f);
+  }
+  __syncthreads();
+
+  // O2 = A v, accumulated into the same fragments as O1 after A is ready.
+#pragma unroll
+  for (int i = 0; i < 2; ++i) {
+    const int tile = warp + 8 * i, m = tile >> 2, n = tile & 3;
+#pragma unroll
+    for (int kk = 0; kk < 64; kk += 16) {
+      AR a;
+      BR b;
+      wmma::load_matrix_sync(a, &s.q[m * 16][kk], QS);
+      wmma::load_matrix_sync(b, &s.k[kk][n * 16], QS);
+      wmma::mma_sync(o2acc[i], a, b, o2acc[i]);
+    }
+  }
+  // temp <- O1 (S is no longer needed).
+#pragma unroll
+  for (int i = 0; i < 2; ++i) {
+    const int tile = warp + 8 * i, m = tile >> 2, n = tile & 3;
+    wmma::store_matrix_sync(&s.temp[m * 16][n * 16], oacc[i], TS,
+                            wmma::mem_row_major);
+  }
+  __syncthreads();
+  // Epilogue in two passes, both through the fp32 temp: O1 scaled by
+  // exp(g_i)*scale, then O2*scale added in place. The global read-modify-write
+  // is 8 KiB per CTA against 2.6 MFLOP of MMA, so it does not matter.
+  for (int x = tid; x < BT * VH; x += THREADS) {
+    const int i = x / VH, vv = x % VH;
+    if (i < rows) {
+      const float v1 = s.temp[i][vv];
+      p.o[int64_t(row0 + i) * p.ot + head * p.oh + vh * VH + vv] =
+          __float2half_rn(p.scale * __expf(s.gs[i]) * v1);
+    }
+  }
+  __syncthreads();
+  // Now store O2 over temp and add into the output.
+#pragma unroll
+  for (int i = 0; i < 2; ++i) {
+    const int tile = warp + 8 * i, m = tile >> 2, n = tile & 3;
+    wmma::store_matrix_sync(&s.temp[m * 16][n * 16], o2acc[i], TS,
+                            wmma::mem_row_major);
+  }
+  __syncthreads();
+  for (int x = tid; x < BT * VH; x += THREADS) {
+    const int i = x / VH, vv = x % VH;
+    if (i < rows) {
+      const float v2 = s.temp[i][vv];
+      __half *dst = &p.o[int64_t(row0 + i) * p.ot + head * p.oh + vh * VH + vv];
+      *dst = __float2half_rn(__half2float(*dst) + p.scale * v2);
+    }
+  }
+}
+
+at::Tensor o(const std::optional<at::Tensor> &out, const at::Tensor &q, const at::Tensor &k, const at::Tensor &v,
+             const at::Tensor &h, const at::Tensor &g, const at::Tensor &cu,
+             const at::Tensor &chunk_indices, double scale) {
+  const c10::cuda::CUDAGuard guard(q.device());
+  TORCH_CHECK(q.is_cuda() && q.dim() == 4 && q.size(0) == 1 &&
+                  q.size(3) == KD && q.stride(3) == 1,
+              "q: [1,T,Hg,128]");
+  TORCH_CHECK(k.sizes() == q.sizes() && v.dim() == 4 && v.size(0) == 1 &&
+                  v.size(1) == q.size(1) && v.size(3) == VD &&
+                  v.stride(3) == 1,
+              "v: [1,T,H,128]");
+  const int T = q.size(1), Hg = q.size(2), H = v.size(2);
+  TORCH_CHECK(H > 0 && Hg > 0 && H % Hg == 0, "head counts");
+  const int64_t total_chunks = chunk_indices.size(0);
+  TORCH_CHECK(h.is_cuda() && h.is_contiguous() && h.dim() >= 3 &&
+                  h.size(-1) == KD && h.size(-2) == VD &&
+                  h.scalar_type() == at::kHalf &&
+                  h.numel() >= total_chunks * H * VD * KD,
+              "h: contiguous [chunks*H,128,128] fp16");
+  TORCH_CHECK(g.dim() == 3 && g.size(1) == T && g.size(2) == H &&
+                  g.scalar_type() == at::kFloat,
+              "g: [1,T,H] fp32");
+  TORCH_CHECK(cu.scalar_type() == at::kInt && cu.is_contiguous() &&
+                  cu.numel() >= 2,
+              "int32 cu_seqlens");
+  TORCH_CHECK(chunk_indices.scalar_type() == at::kInt &&
+                  chunk_indices.is_contiguous() && chunk_indices.dim() == 2 &&
+                  chunk_indices.size(1) == 2,
+              "chunk_indices: [N,2] int32");
+  at::Tensor o;
+  if (out) {
+    TORCH_CHECK(out->is_cuda() && out->scalar_type() == at::kHalf &&
+                    out->is_contiguous() && out->numel() >= v.numel(),
+                "out: contiguous fp16 buffer with room for v");
+    o = out->view({-1}).narrow(0, 0, v.numel()).view(v.sizes());
+    TORCH_CHECK(o.is_contiguous(), "out view");
+  } else {
+    o = at::empty_like(v);
+  }
+  Params p{};
+  p.q = (const __half *)q.data_ptr();
+  p.k = (const __half *)k.data_ptr();
+  p.v = (const __half *)v.data_ptr();
+  p.h = (const __half *)h.data_ptr();
+  p.g = g.data_ptr<float>();
+  p.o = (__half *)o.data_ptr();
+  p.cu = cu.data_ptr<int32_t>();
+  p.chunk_indices = chunk_indices.data_ptr<int32_t>();
+  p.H = H;
+  p.Hg = Hg;
+  p.scale = (float)scale;
+  p.qt = q.stride(1); p.qh = q.stride(2);
+  p.kt = k.stride(1); p.kh = k.stride(2);
+  p.vt = v.stride(1); p.vh = v.stride(2);
+  p.ot = o.stride(1); p.oh = o.stride(2);
+  // h is contiguous with the last two dims [V, K]; the (chunk, head) pair
+  // folds into the leading dims, so the row stride is V*K and the v stride K.
+  p.ht = 0; p.hh = (int64_t)VD * KD; p.hv = KD;
+  p.gt = g.stride(1); p.gh = g.stride(2);
+  const size_t smem = sizeof(Shared);
+  TORCH_CHECK(smem <= 64 * 1024, "shared storage too large");
+  auto fn = o_kernel;
+  cudaFuncSetAttribute(fn, cudaFuncAttributeMaxDynamicSharedMemorySize,
+                       (int)smem);
+  fn<<<dim3((unsigned)total_chunks, (unsigned)(H * 2)), THREADS, smem,
+          c10::cuda::getCurrentCUDAStream()>>>(p);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  return o;
+}
+} // namespace
+
+TORCH_LIBRARY(qwen38_turing_gdn_o, m) {
+  m.def("o(Tensor? out, Tensor q, Tensor k, Tensor v, Tensor h, Tensor g, Tensor cu, "
+        "Tensor chunk_indices, float scale) -> Tensor");
+}
+TORCH_LIBRARY_IMPL(qwen38_turing_gdn_o, CUDA, m) { m.impl("o", o); }
