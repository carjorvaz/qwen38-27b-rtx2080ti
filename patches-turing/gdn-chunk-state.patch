+++ b/third_party/flash_linear_attention/ops/turing_gdn.cu
@@ -0,0 +1,251 @@
+// SM75 GDN chunk-state update. FP16 MMA operands, FP32 recurrent state.
+#include <ATen/core/Tensor.h>
+#include <ATen/ops/empty.h>
+#include <c10/cuda/CUDAException.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cmath>
+#include <cuda_fp16.h>
+#include <mma.h>
+#include <torch/library.h>
+#include <tuple>
+
+namespace {
+namespace wmma = nvcuda::wmma;
+constexpr int BT = 64, D = 128, VT = 32, THREADS = 128;
+constexpr int BS = D + 8, VS = VT + 8, FS = D + 4, PS = VT + 4;
+using Acc = wmma::fragment<wmma::accumulator, 16, 16, 16, float>;
+using AR = wmma::fragment<wmma::matrix_a, 16, 16, 16, __half, wmma::row_major>;
+using AC = wmma::fragment<wmma::matrix_a, 16, 16, 16, __half, wmma::col_major>;
+using BR = wmma::fragment<wmma::matrix_b, 16, 16, 16, __half, wmma::row_major>;
+using BC = wmma::fragment<wmma::matrix_b, 16, 16, 16, __half, wmma::col_major>;
+struct Params {
+  const __half *k, *w, *u;
+  const float *g;
+  const void *h0;
+  __half *h, *vn;
+  float *hf;
+  const int32_t *cu;
+  const void *offsets;
+  int T, H, Hg, NT;
+  bool initial_float, offsets_long;
+  int64_t kt, kh, wt, wh, ut, uh, gt, gh, ht, hh, hv;
+};
+struct __align__(32) Shared {
+  __half operand[BT][BS];
+  __half state_half[VT][BS];
+  __half value[BT][VS];
+  union {
+    float state[VT][FS];
+    float projection[BT][PS];
+  } temp;
+};
+static_assert(sizeof(Shared) <= 48 * 1024);
+
+__global__ void state_kernel(Params p) {
+  __shared__ Shared s;
+  const int head = blockIdx.x % p.H, seq = blockIdx.x / p.H;
+  const int value_start = blockIdx.y * VT;
+  const int begin = p.cu[seq], end = p.cu[seq + 1], length = end - begin;
+  const int chunk_base = p.offsets_long
+                             ? static_cast<const int64_t *>(p.offsets)[seq]
+                             : static_cast<const int32_t *>(p.offsets)[seq];
+  const int chunks = (length + BT - 1) / BT;
+  const int warp = threadIdx.x / 32, tid = threadIdx.x;
+  Acc state[4];
+  for (int x = tid; x < VT * D; x += THREADS) {
+    const int v = x / D, k = x % D;
+    const int64_t off = seq * p.ht + head * p.hh + (value_start + v) * p.hv + k;
+    s.temp.state[v][k] =
+        p.h0 ? (p.initial_float
+                    ? static_cast<const float *>(p.h0)[off]
+                    : __half2float(static_cast<const __half *>(p.h0)[off]))
+             : 0.f;
+  }
+  __syncthreads();
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const int tile = warp + 4 * i, vm = tile / 8, kn = tile % 8;
+    wmma::load_matrix_sync(state[i], &s.temp.state[vm * 16][kn * 16], FS,
+                           wmma::mem_row_major);
+  }
+  for (int chunk = 0; chunk < chunks; ++chunk) {
+    const int t0 = chunk * BT;
+    // Keep FP32 state in registers; publish its FP16 pre-chunk snapshot.
+    __syncthreads();
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      const int tile = warp + 4 * i, vm = tile / 8, kn = tile % 8;
+      wmma::store_matrix_sync(&s.temp.state[vm * 16][kn * 16], state[i], FS,
+                              wmma::mem_row_major);
+    }
+    __syncthreads();
+    for (int x = tid; x < VT * D; x += THREADS) {
+      const int v = x / D, k = x % D;
+      __half value = __float2half_rn(s.temp.state[v][k]);
+      s.state_half[v][k] = value;
+      p.h[((int64_t(chunk_base + chunk) * p.H + head) * D + value_start + v) *
+              D +
+          k] = value;
+    }
+    for (int x = tid; x < BT * D; x += THREADS) {
+      const int row = x / D, k = x % D, token = begin + t0 + row;
+      s.operand[row][k] = token < end
+                              ? p.w[int64_t(token) * p.wt + head * p.wh + k]
+                              : __float2half_rn(0.f);
+    }
+    __syncthreads();
+    Acc projection[2];
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+      const int tile = warp + 4 * i, m = tile / 2, n = tile % 2;
+      wmma::fill_fragment(projection[i], 0.f);
+#pragma unroll
+      for (int kk = 0; kk < D; kk += 16) {
+        AR a;
+        BC b;
+        wmma::load_matrix_sync(a, &s.operand[m * 16][kk], BS);
+        wmma::load_matrix_sync(b, &s.state_half[n * 16][kk], BS);
+        wmma::mma_sync(projection[i], a, b, projection[i]);
+      }
+      wmma::store_matrix_sync(&s.temp.projection[m * 16][n * 16], projection[i],
+                              PS, wmma::mem_row_major);
+    }
+    __syncthreads();
+    const int last = begin + min(t0 + BT, length) - 1;
+    const float g_last = p.g[int64_t(last) * p.gt + head * p.gh];
+    for (int x = tid; x < BT * VT; x += THREADS) {
+      const int row = x / VT, v = x % VT, token = begin + t0 + row;
+      float updated = 0.f;
+      if (token < end) {
+        updated =
+            __half2float(
+                p.u[int64_t(token) * p.ut + head * p.uh + value_start + v]) -
+            s.temp.projection[row][v];
+        p.vn[(int64_t(token) * p.H + head) * D + value_start + v] =
+            __float2half_rn(updated);
+        updated *= expf(g_last - p.g[int64_t(token) * p.gt + head * p.gh]);
+      }
+      s.value[row][v] = __float2half_rn(updated);
+    }
+    for (int x = tid; x < BT * D; x += THREADS) {
+      const int row = x / D, k = x % D, token = begin + t0 + row;
+      s.operand[row][k] =
+          token < end
+              ? p.k[int64_t(token) * p.kt + (head / (p.H / p.Hg)) * p.kh + k]
+              : __float2half_rn(0.f);
+    }
+    __syncthreads();
+    const float decay = expf(g_last);
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      const int tile = warp + 4 * i, vm = tile / 8, kn = tile % 8;
+#pragma unroll
+      for (int j = 0; j < state[i].num_elements; ++j)
+        state[i].x[j] *= decay;
+#pragma unroll
+      for (int kk = 0; kk < BT; kk += 16) {
+        AC a;
+        BR b;
+        wmma::load_matrix_sync(a, &s.value[kk][vm * 16], VS);
+        wmma::load_matrix_sync(b, &s.operand[kk][kn * 16], BS);
+        wmma::mma_sync(state[i], a, b, state[i]);
+      }
+    }
+  }
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const int tile = warp + 4 * i, vm = tile / 8, kn = tile % 8;
+    wmma::store_matrix_sync(
+        p.hf + ((int64_t(seq) * p.H + head) * D + value_start + vm * 16) * D +
+            kn * 16,
+        state[i], D, wmma::mem_row_major);
+  }
+}
+
+std::tuple<at::Tensor, at::Tensor, at::Tensor>
+state(const at::Tensor &k, const at::Tensor &w, const at::Tensor &u,
+      const at::Tensor &g, const std::optional<at::Tensor> &initial,
+      const at::Tensor &cu, const at::Tensor &offsets, int64_t total_chunks) {
+  const c10::cuda::CUDAGuard guard(k.device());
+  TORCH_CHECK(k.is_cuda() && k.dim() == 4 && k.size(0) == 1 && k.size(3) == D &&
+                  k.stride(3) == 1,
+              "k: [1,T,Hg,128]");
+  const int T = k.size(1), Hg = k.size(2), H = u.size(2), N = cu.numel() - 1;
+  TORCH_CHECK(T > 0 && Hg > 0 && H > 0 && H % Hg == 0 && N > 0 &&
+                  total_chunks > 0,
+              "invalid dimensions");
+  TORCH_CHECK(w.sizes() == u.sizes() && w.dim() == 4 && w.size(0) == 1 &&
+                  w.size(1) == T && w.size(3) == D,
+              "w/u shape");
+  TORCH_CHECK(g.dim() == 3 && g.size(0) == 1 && g.size(1) == T &&
+                  g.size(2) == H,
+              "g shape");
+  for (const auto *tensor : {&k, &w, &u}) {
+    TORCH_CHECK(tensor->device() == k.device() &&
+                    tensor->scalar_type() == at::kHalf &&
+                    tensor->stride(3) == 1,
+                "FP16 inputs with contiguous head dims required");
+  }
+  TORCH_CHECK(g.device() == k.device() && g.scalar_type() == at::kFloat,
+              "g FP32");
+  TORCH_CHECK(cu.device() == k.device() && cu.scalar_type() == at::kInt &&
+                  cu.is_contiguous(),
+              "int32 cu_seqlens");
+  TORCH_CHECK(offsets.device() == k.device() &&
+                  (offsets.scalar_type() == at::kInt ||
+                   offsets.scalar_type() == at::kLong) &&
+                  offsets.is_contiguous() && offsets.numel() >= N,
+              "chunk offsets");
+  if (initial)
+    TORCH_CHECK(initial->device() == k.device() && initial->dim() == 4 &&
+                    initial->size(0) == N && initial->size(1) == H &&
+                    initial->size(2) == D && initial->size(3) == D &&
+                    initial->stride(3) == 1 &&
+                    (initial->scalar_type() == at::kHalf ||
+                     initial->scalar_type() == at::kFloat),
+                "initial state");
+  auto h = at::empty({1, total_chunks, H, D, D}, k.options());
+  auto vn = at::empty(u.sizes(), u.options());
+  auto hf = at::empty({N, H, D, D}, k.options().dtype(at::kFloat));
+  Params p{};
+  p.k = (const __half *)k.data_ptr();
+  p.w = (const __half *)w.data_ptr();
+  p.u = (const __half *)u.data_ptr();
+  p.g = g.data_ptr<float>();
+  p.h0 = initial ? initial->data_ptr() : nullptr;
+  p.initial_float = initial && initial->scalar_type() == at::kFloat;
+  p.h = (__half *)h.data_ptr();
+  p.vn = (__half *)vn.data_ptr();
+  p.hf = hf.data_ptr<float>();
+  p.cu = cu.data_ptr<int32_t>();
+  p.offsets = offsets.data_ptr();
+  p.offsets_long = offsets.scalar_type() == at::kLong;
+  p.T = T;
+  p.H = H;
+  p.Hg = Hg;
+  p.NT = total_chunks;
+  p.kt = k.stride(1);
+  p.kh = k.stride(2);
+  p.wt = w.stride(1);
+  p.wh = w.stride(2);
+  p.ut = u.stride(1);
+  p.uh = u.stride(2);
+  p.gt = g.stride(1);
+  p.gh = g.stride(2);
+  if (initial) {
+    p.ht = initial->stride(0);
+    p.hh = initial->stride(1);
+    p.hv = initial->stride(2);
+  }
+  state_kernel<<<dim3(N * H, D / VT), THREADS, 0,
+                 c10::cuda::getCurrentCUDAStream()>>>(p);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  return {h, vn, hf};
+}
+} // namespace
+TORCH_LIBRARY(qwen38_turing_gdn, m) {
+  m.def("state(Tensor k, Tensor w, Tensor u, Tensor g, Tensor? initial, Tensor "
+        "cu, Tensor offsets, int total_chunks) -> (Tensor, Tensor, Tensor)");
+}
+TORCH_LIBRARY_IMPL(qwen38_turing_gdn, CUDA, m) { m.impl("state", state); }
