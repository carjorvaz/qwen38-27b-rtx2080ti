+    def _apply_mtp_lookup(
+        self,
+        num_reqs: int,
+        num_sampled: torch.Tensor,
+        num_rejected: torch.Tensor,
+    ) -> None:
+        """Propose the draft block from the request's own history (VLLM_MTP_LOOKUP).
+
+        A request that is reproducing its prompt (quoting a document, applying an
+        edit) has its continuation already in the token history. V2 keeps that
+        history in `req_states.all_token_ids`, current at propose() time, so the
+        lookup runs directly against it; V1 builds the same thing in the proposer.
+
+        An override is taken only when the step that just finished accepted every
+        token it was given (evidence that a copy is running), the previous step's
+        match was long enough, and this step's match can fill the whole block.
+        Everything is decided on device, so there is no host synchronization. The
+        draft distribution for an overridden request becomes a point mass on the
+        proposed token, which is a legal q for rejection sampling, so the output
+        distribution is unchanged.
+        """
+        if not self._lookup_enabled or self.method != "mtp" or self._req_states is None:
+            return
+        k = self.num_speculative_steps
+        if k < 1 or num_reqs <= 0:
+            return
+        logger.info_once(
+            "MTP history lookup on (V2): min=%d nmin=%d nmax=%d k=%d",
+            self._lookup_min,
+            self._lookup_nmin,
+            self._lookup_nmax,
+            k,
+        )
+        from vllm.v1.worker.gpu.spec_decode.dflash2.lookup import suffix_lookup
+
+        _, match_len, valid = suffix_lookup(
+            self._req_states.all_token_ids.gpu,
+            self._req_states.total_len.gpu,
+            self.idx_mapping,
+            num_reqs,
+            k=k,
+            nmax=self._lookup_nmax,
+            nmin=self._lookup_nmin,
+            search_max=self._lookup_search,
+            min_tail=k,
+            out_tokens=self._lookup_tokens[:num_reqs],
+            out_len=self._lookup_len[:num_reqs],
+            out_valid=self._lookup_valid[:num_reqs],
+        )
+        current_ok = (valid[:num_reqs] >= k) & (
+            match_len[:num_reqs] >= self._lookup_min
+        )
+        if self._lookup_sample:
+            sampled_ok = torch.ones(
+                num_reqs, dtype=torch.bool, device=self.device
+            )
+        else:
+            # Greedy only by default: a point-mass proposal is a weaker draft
+            # than the drafter's own distribution wherever the drafter is right.
+            sampled_ok = self.temperature[:num_reqs] == 0
+        use = (
+            current_ok
+            & sampled_ok
+            & (self._lookup_prev_ok[:num_reqs] != 0)
+            & (num_sampled[:num_reqs] >= k + 1)
+            & (num_rejected[:num_reqs] == 0)
+        ).to(torch.int32)
