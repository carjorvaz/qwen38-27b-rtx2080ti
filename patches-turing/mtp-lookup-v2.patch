+def _mtp_lookup_apply_kernel(
+    draft_tokens_ptr,
+    draft_tokens_stride,
+    draft_logits_ptr,
+    draft_logits_stride_0,
+    draft_logits_stride_1,
+    lookup_tokens_ptr,
+    lookup_tokens_stride,
+    use_ptr,
+    idx_mapping_ptr,
+    vocab_size,
+    k: tl.constexpr,
+    HAS_LOGITS: tl.constexpr,
+    BLOCK_V: tl.constexpr,
+):
+    """Write the lookup's proposal where the gate selected it, and make the draft
+    distribution a point mass on that token (a legal q for rejection sampling).
+    The row is rewritten in full because the rejection sampler softmaxes it."""
+    flat = tl.program_id(0)
+    req = flat // k
+    step = flat % k
+    if tl.load(use_ptr + req) == 0:
+        return
+    req_state = tl.load(idx_mapping_ptr + req)
+    if req_state < 0:
+        return
+    token = tl.load(lookup_tokens_ptr + req * lookup_tokens_stride + step).to(tl.int64)
+    tl.store(draft_tokens_ptr + req * draft_tokens_stride + step, token)
+    if HAS_LOGITS:
+        row = (
+            draft_logits_ptr
+            + req_state * draft_logits_stride_0
+            + step * draft_logits_stride_1
+        )
+        offsets = tl.arange(0, BLOCK_V)
+        neg_inf = tl.full((BLOCK_V,), float("-inf"), tl.float32)
+        for start in range(0, vocab_size, BLOCK_V):
+            mask = start + offsets < vocab_size
+            tl.store(row + start + offsets, neg_inf, mask=mask)
+        tl.store(row + token, 0.0)
+
