+// Vectorized packed-INT4 staging. The per-element path loads one byte per dim
+// (two threads load the same byte) and a warp covers 16 useful bytes per
+// transaction, which leaves the KV loop latency-bound. Here each thread loads
+// two 4-byte words of one row (16 dims) and stores 16 halves; the lanes of a
+// warp cover two complete 128-byte rows per load instruction. 4-byte alignment
+// is required and holds for both caches: the row stride is 264 bytes and the
+// V view is offset by 132, so 8-byte loads are not always aligned.
+__device__ __forceinline__ void stage_packed_rows(const void *base, Shared &s,
+                                                  const int64_t *offsets,
+                                                  const int *zeros, int tid,
+                                                  int warp, int lane) {
+  constexpr int kWordsPerRow = (kDim / 2) / 4;             // 32
+  constexpr int kRowsPerIteration = (kThreads * 2) / kWordsPerRow;  // 8
+  const uint8_t *bytes = static_cast<const uint8_t *>(base);
+#pragma unroll
+  for (int row_base = 0; row_base < kKeys; row_base += kRowsPerIteration) {
+    const int row = row_base + warp * 2 + (lane >> 4);
+    const int word0 = lane & 15;
+    const int word1 = word0 + kWordsPerRow / 2;
+    const int64_t offset = offsets[row];
+    __half values[16];
+    if (offset >= 0) {
+      const uint32_t first =
+          *reinterpret_cast<const uint32_t *>(bytes + offset + word0 * 4);
+      const uint32_t second =
+          *reinterpret_cast<const uint32_t *>(bytes + offset + word1 * 4);
+      const int zero = zeros[row];
+#pragma unroll
+      for (int i = 0; i < 8; ++i) {
+        values[i] = __int2half_rn(static_cast<int>((first >> (4 * i)) & 15) - zero);
+        values[8 + i] =
+            __int2half_rn(static_cast<int>((second >> (4 * i)) & 15) - zero);
+      }
+    } else {
+#pragma unroll
+      for (int i = 0; i < 16; ++i) {
+        values[i] = __float2half_rn(0.0f);
+      }
+    }
+    // The two words are 128 dims apart, not adjacent: store each half at its
+    // own dim offset (word0*8 and word0*8 + kDim/2).
+    *reinterpret_cast<uint4 *>(&s.kv[row][word0 * 8]) =
+        *reinterpret_cast<const uint4 *>(values);
+    *reinterpret_cast<uint4 *>(&s.kv[row][word0 * 8 + kDim / 2]) =
+        *reinterpret_cast<const uint4 *>(values + 8);
+  }
+}
