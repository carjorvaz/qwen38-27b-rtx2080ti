+# Butterfly (gather) Hadamard kernel — the replacement for the dense-matrix
+# tiers when D exceeds the matrix smem budget and hadacore is unavailable
+# (e.g. head_dim = 256 on SM75/Turing, where the MMA tier's H matrix would
+# need 2·D² = 128 KiB).  It performs the same log2(D) in-register stages as
+# the PyTorch fallback, in the same order and in fp32, but in ONE launch.
+#
+# Total fp32 working set per program is ROWS · D · 4 bytes; cap it at 32 KiB
+# so the tile stays inside the register file on every SM75 profile.
+_TRITON_HADAMARD_BUTTERFLY_MAX_D = 4096
+_BUTTERFLY_TILE_BYTES = 32768
+
+
+@triton.jit
+def _hadamard_butterfly_kernel(
+    x_ptr,
+    out_ptr,
+    n_rows,
+    stride_x_row: tl.int64,
+    stride_o_row: tl.int64,
+    ROWS: tl.constexpr,
+    D: tl.constexpr,
+    STAGES: tl.constexpr,
+):
+    """Unnormalized fp32 Walsh-Hadamard butterfly along the last axis.
+
+    Stage ``s`` pairs every element with its ``1 << s`` neighbour:
+    ``x + partner`` where the stage bit is clear, ``partner - x`` where it
+    is set — identical arithmetic and identical stage order to the
+    ``torch.stack([a + b, a - b])`` loop it replaces.
+    """
+    pid = tl.program_id(0)
+    rows = pid * ROWS + tl.arange(0, ROWS)
+    cols = tl.arange(0, D)
+    row_mask = rows < n_rows
+    x = tl.load(
+        x_ptr + rows[:, None] * stride_x_row + cols[None, :],
+        mask=row_mask[:, None],
+        other=0.0,
+    ).to(tl.float32)
+    for stage in tl.static_range(0, STAGES):
+        bit = 1 << stage
+        partner = tl.gather(x, tl.broadcast_to((cols ^ bit)[None, :], x.shape), axis=1)
+        x = tl.where((cols[None, :] & bit) == 0, x + partner, partner - x)
+    tl.store(
+        out_ptr + rows[:, None] * stride_o_row + cols[None, :],
+        x.to(out_ptr.dtype.element_ty),
+        mask=row_mask[:, None],
+    )
+
+
+def _triton_hadamard_butterfly(x: torch.Tensor) -> torch.Tensor:
+    """H_d × x for D above the dense-matrix tiers, without a D × D matrix.
+
+    Numerically identical to the PyTorch stage loop in ``fast_hadamard_transform``:
+    fp32 add/sub only, same pairing, same stage order.  One kernel launch
+    instead of 8 stages of view/slice/stack/reshape (≈24 launches and 8
+    full-size temporaries per call on CUDA).
+    """
+    d = x.shape[-1]
+    orig_shape = x.shape
+    x2d = x.contiguous().reshape(-1, d)
+    out2d = torch.empty_like(x2d)
+    rows = max(1, min(16, _BUTTERFLY_TILE_BYTES // (d * 4)))
+    _hadamard_butterfly_kernel[(triton.cdiv(x2d.shape[0], rows),)](
+        x2d,
+        out2d,
+        x2d.shape[0],
+        x2d.stride(0),
+        out2d.stride(0),
+        ROWS=rows,
+        D=d,
+        STAGES=d.bit_length() - 1,
+        num_warps=4,
+    )
+    return out2d.reshape(orig_shape)
+
+
