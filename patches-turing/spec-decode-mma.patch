+"""SM75 Tensor Core partial attention; load before CUDA graph capture."""
+
+from functools import cache
+from pathlib import Path
+
+import torch
+
+
+@cache
+def load_turing_partial():
+    from torch.utils.cpp_extension import load
+
+    load(
+        name="qwen38_turing_partial",
+        sources=[str(Path(__file__).with_suffix(".cu"))],
+        extra_cflags=["-O3", "-std=c++17"],
+        extra_cuda_cflags=[
+            "-O3",
+            "-std=c++17",
+            "--expt-relaxed-constexpr",
+            "-gencode=arch=compute_75,code=sm_75",
+        ],
+        is_python_module=False,
+    )
+    return torch.ops.qwen38_turing.partial.default
