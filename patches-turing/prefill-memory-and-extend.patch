@@ -0,0 +1,120 @@
+"""Bounded-workspace SM75 prefill using FP32 log-sum-exp merging.
+
+KV windows before the query suffix are noncausal. The final window contains
+ALL query tokens and uses lower-right causal masking; never apply a local
+causal mask independently to every KV window.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+from .turing_prefill_tiles import load_turing_prefill_tiles
+
+
+@triton.jit
+def _merge(
+    part,
+    part_lse,
+    accum,
+    lse,
+    Q: tl.constexpr,
+    H: tl.constexpr,
+    G: tl.constexpr,
+    LSE_Q: tl.constexpr,
+    D: tl.constexpr,
+    FIRST: tl.constexpr,
+):
+    row = tl.program_id(0)
+    token, head = row // H, row % H
+    d = tl.arange(0, D)
+    current = tl.load(part_lse + head * LSE_Q + token)
+    value = tl.load(part + ((head // G * Q + token) * G + head % G) * D + d).to(
+        tl.float32
+    )
+    if FIRST:
+        result, total = value, current
+    else:
+        previous = tl.load(lse + row)
+        maximum = tl.maximum(previous, current)
+        a, b = tl.exp(previous - maximum), tl.exp(current - maximum)
+        total = maximum + tl.log(a + b)
+        result = (tl.load(accum + row * D + d) * a + value * b) / (a + b)
+    tl.store(accum + row * D + d, result)
+    tl.store(lse + row, total)
+
+
+def stream_prefill(workspace, q, k, v, out, table, num_keys, scale, ks, vs):
+    from .turing_prefill_attn import _gather_kv
+
+    qlen, heads, dim = q.shape
+    packed = k.dtype == torch.uint8
+    quant = ks is not None
+    if packed:
+        from .int4_per_token_head import _get_rht_signs
+        from .turing_spec_attn import load_turing_rht
+
+        rht = load_turing_rht()
+        signs = _get_rht_signs(dim, 0, q.device)
+        rht(q, out, signs, False)
+        q = out
+        scale /= dim
+    group = heads // workspace.num_kv_heads
+    grouped_q = q.view(qlen, workspace.num_kv_heads, group, dim).permute(1, 0, 2, 3)
+    load_turing_prefill_tiles()
+    capacity = workspace.key.shape[1]
+    if qlen > capacity:
+        raise ValueError("stream workspace must hold a complete prefill query chunk")
+    accum = workspace.stream_accum[:qlen]
+    lse = workspace.stream_lse[:qlen]
+    start = 0
+    while start < num_keys:
+        remaining = num_keys - start
+        # Do not split the query suffix: earlier windows are wholly visible.
+        size = remaining if remaining <= capacity else min(capacity, remaining - qlen)
+        final = start + size == num_keys
+        _gather_kv[(triton.cdiv(size, 16), workspace.num_kv_heads)](
+            k,
+            v,
+            ks,
+            vs,
+            table,
+            workspace.key,
+            workspace.value,
+            start + size,
+            *k.stride(),
+            *v.stride(),
+            *(ks.stride() if quant else (0, 0, 0)),
+            *(vs.stride() if quant else (0, 0, 0)),
+            start=start,
+            capacity=capacity,
+            D=dim,
+            BLOCK=k.shape[1],
+            QUANT=quant,
+            PACKED=packed,
+            ROWS=16,
+            num_warps=4,
+            num_stages=1,
+        )
+        part, part_lse = torch.ops.qwen38_turing_prefill_tiles.attention_lse(
+            grouped_q, workspace.key[:, :size], workspace.value[:, :size], scale, final
+        )
+        _merge[(qlen * heads,)](
+            part,
+            part_lse,
+            accum,
+            lse,
+            Q=qlen,
+            H=heads,
+            G=group,
+            LSE_Q=part_lse.shape[-1],
+            D=dim,
+            FIRST=start == 0,
+            num_warps=4,
+        )
+        start += size
+    if packed:
+        rht(accum, out, signs, True)
+    else:
+        out.copy_(accum)
+    return out
