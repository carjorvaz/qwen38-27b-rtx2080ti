+"""SM75 D256 lower-right causal GQA prefill; other inputs retain PyTorch SDPA.
+
+A 256-key Cutlass tile keeps the FP32 output accumulator in registers. The
+pinned PyTorch template is copied into the extension build cache, never edited
+in site-packages. VLLM_TURING_PREFILL_TILE=0 selects the original implementation.
+"""
+from functools import cache
+import fcntl
+import hashlib
+import os
+from pathlib import Path
+
+import torch
+from torch.nn.attention.bias import CausalBias, CausalVariant
+from torch.nn.functional import scaled_dot_product_attention as reference_attention
+
+
+@cache
+def _is_sm75(device):
+    return torch.cuda.get_device_capability(device) == (7, 5)
+
+
+def _prepare_header(build):
+    header = (Path(torch.__file__).parent / "include/ATen/native/transformers/cuda/"
+              "mem_eff_attention/kernel_forward.h")
+    original = header.read_bytes()
+    expected = "3f8734984c5b15b947b26ff663d99466f0916f746082417e56acd15243efe832"
+    if hashlib.sha256(original).hexdigest() != expected:
+        raise RuntimeError("PyTorch attention template changed; revalidate the SM75 tile port")
+    text = original.decode()
+    edits = [
+        ("  static constexpr int kNumWarpsPerBlock =\n"
+         "      kQueriesPerBlock * kKeysPerBlock / (32 * 32);",
+         "  // Wider N warp tiles preserve the small query operand's load iterator.\n"
+         "  static constexpr int kWarpN = kKeysPerBlock == 256 ? 64 : 32;\n"
+         "  static constexpr int kNumWarpsPerBlock =\n"
+         "      kQueriesPerBlock * kKeysPerBlock / (32 * kWarpN);", 1),
+        ("  static constexpr int kMinBlocksPerSm =\n",
+         "  static constexpr int kMinBlocksPerSm = kKeysPerBlock == 256 ? 1 :\n", 1),
+        ("cutlass::gemm::GemmShape<32, 32, GemmType::WarpK>",
+         "cutlass::gemm::GemmShape<32, kWarpN, GemmType::WarpK>", 2),
+        ("typename DefaultGemm::Mma::Policy::Operator::Shape, // WarpShape",
+         "// Widening N does not change A's M/K layout.\n"
+         "            cutlass::gemm::GemmShape<32, 32, GemmType::WarpK>,", 1),
+    ]
+    for before, after, count in edits:
+        if text.count(before) != count:
+            raise RuntimeError("Unexpected PyTorch attention template layout")
+        text = text.replace(before, after)
+    build.mkdir(parents=True, exist_ok=True)
+    destination = build / "turing_kernel_forward.h"
+    with (build / ".header.lock").open("a+") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        if not destination.exists() or destination.read_text() != text:
+            temporary = build / f".header-{os.getpid()}.tmp"
+            temporary.write_text(text)
+            os.replace(temporary, destination)
+
+
+@cache
+def load_turing_prefill_tiles():
+    from torch.utils.cpp_extension import get_default_build_root, load
+    import vllm
+
+    name = "qwen38_turing_prefill_tiles"
+    build = Path(os.environ.get("TORCH_EXTENSIONS_DIR", get_default_build_root())) / name
+    _prepare_header(build)
+    cutlass = Path(vllm.__file__).parent / "third_party/deep_gemm/include"
+    load(
+        name=name,
+        sources=[str(Path(__file__).with_suffix(".cu"))],
+        build_directory=str(build),
+        extra_include_paths=[str(build), str(cutlass)],
+        extra_cflags=["-O3", "-std=c++17"],
+        extra_cuda_cflags=[
+            "-O3", "-std=c++17", "--expt-relaxed-constexpr",
+            "-gencode=arch=compute_75,code=sm_75",
+        ],
+        is_python_module=False,
+    )
+    return torch.ops.qwen38_turing_prefill_tiles.attention.default
+
+
+def scaled_dot_product_attention(q, k, v, *, attn_mask, scale):
+    supported = (
+        os.environ.get("VLLM_TURING_PREFILL_TILE", "256") == "256"
+        and q.is_cuda
+        and q.dtype == k.dtype == v.dtype == torch.float16
+        and q.ndim == k.ndim == v.ndim == 4
+        and q.shape[-1] == 256
+        and k.shape == v.shape
+        and q.shape[:2] == k.shape[:2]
+        and q.shape[0] > 0 and q.shape[1] > 0
+        and k.stride(1) == v.stride(1) == 0
+        and all(
+            t.device == q.device and t.stride(-1) == 1
+            and not t.requires_grad and t.data_ptr() % 16 == 0
+            and all(stride % 8 == 0 for stride in t.stride()[:-1])
+            for t in (q, k, v)
+        )
+        and 0 < q.shape[-2] <= k.shape[-2]
+        and isinstance(attn_mask, CausalBias)
+        and attn_mask.variant == CausalVariant.LOWER_RIGHT
+        and attn_mask.seq_len_q == q.shape[-2]
+        and attn_mask.seq_len_kv == k.shape[-2]
+        and scale is not None
+        and _is_sm75(q.device)
+    )
+    if not supported:
+        return reference_attention(q, k, v, attn_mask=attn_mask, scale=scale)
+    return load_turing_prefill_tiles()(
+        q.permute(0, 2, 1, 3), k[:, 0], v[:, 0], scale
+    ).permute(0, 2, 1, 3)
--- /dev/null
