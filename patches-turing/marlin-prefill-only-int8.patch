--- /dev/null
+++ b/model_executor/layers/quantization/utils/turing_marlin_prefill.py
@@ -0,0 +1,212 @@
+"""Transient W4A16 -> W4A8 Marlin repack: canonical weights stay untouched.
+
+The extra packed matrix exists only for one GEMM, not for the whole model.
+Negative group scales are folded into the codes as in the existing load-time
+INT8 path (the -8 endpoint becomes -7). Decode keeps original weights/scales.
+"""
+
+from functools import lru_cache
+
+import torch
+import triton
+import triton.language as tl
+
+
+@lru_cache(None)
+def _permutations():
+    # Same layouts as marlin_utils_test.get_weight_perm, without a production
+    # dependency on test helpers. 1024 nibbles per Marlin permutation block.
+    def perm(a8):
+        result = []
+        for i in range(32):
+            rows = (
+                [4 * (i % 4) + j for j in range(4)]
+                + [4 * (i % 4 + 4) + j for j in range(4)]
+                if a8
+                else [
+                    2 * (i % 4),
+                    2 * (i % 4) + 1,
+                    2 * (i % 4 + 4),
+                    2 * (i % 4 + 4) + 1,
+                ]
+            )
+            part = [16 * r + i // 4 + 8 * b for b in (0, 1) for r in rows]
+            result += [
+                p + 256 * (2 if a8 else 1) * j
+                for j in range(2 if a8 else 4)
+                for p in part
+            ]
+        order = [0, 4, 1, 5, 2, 6, 3, 7] if a8 else [0, 2, 4, 6, 1, 3, 5, 7]
+        return [result[i + j] for i in range(0, 1024, 8) for j in order]
+
+    def inverse(p):
+        out = [0] * len(p)
+        for i, x in enumerate(p):
+            out[x] = i
+        return out
+
+    scale64 = [i + 8 * j for i in range(8) for j in range(8)]
+    scale32 = [2 * i + j for i in range(4) for j in (0, 1, 8, 9, 16, 17, 24, 25)]
+    return perm(True), inverse(perm(False)), inverse(scale64), scale32
+
+
+@lru_cache(None)
+def _maps(device):
+    return tuple(
+        torch.tensor(x, dtype=torch.int32, device=device) for x in _permutations()
+    )
+
+
+@lru_cache(None)
+def _repack_maps(device, n):
+    # Compile the intra-tile permutation once. Only scalar tile coordinates
+    # need division in the hot kernel; each CTA produces one 32x32 tile.
+    p8, i16, i64, _ = _permutations()
+    positions, columns = [], []
+    for parity in range(2):
+        for p in p8:
+            rk, rn = p % 512 // 16, parity * 32 + p // 512 * 16 + p % 16
+            positions.append(
+                (rk // 16) * n * 16 + i16[rn // 16 * 256 + rk % 16 * 16 + rn % 16]
+            )
+            columns.append(i64[rn])
+    return (
+        torch.tensor(positions, dtype=torch.int32, device=device),
+        torch.tensor(columns, dtype=torch.int32, device=device),
+    )
+
+
+def prepare(device, padded_n):
+    """Create tiny immutable lookup tables at model load, before graph capture."""
+    _maps(device)
+    _repack_maps(device, padded_n)
+
+
+@triton.jit
+def _repack(w, scales, dest, positions, columns, N: tl.constexpr):
+    tile = tl.program_id(0)
+    word = tl.arange(0, 128)
+    nib = tl.arange(0, 8)
+    pos = tile % 2 * 1024 + word[:, None] * 8 + nib[None, :]
+    old = tl.load(positions + pos)
+    base = tile // (N // 32) * N * 32 + (tile % (N // 32) // 2) * 1024
+    bits = tl.load(w + base // 8 + old // 8).to(tl.uint32)
+    code = (bits >> ((old % 8) * 4)) & 15
+    scale_base = tile // (N // 32) // 4 * N + (tile % (N // 32) // 2) * 64
+    scale = tl.load(scales + scale_base + tl.load(columns + pos))
+    code = tl.where(scale < 0, tl.minimum(16 - code, 15), code)
+    packed = tl.sum(code.to(tl.uint32) << (nib[None, :] * 4), 1)
+    tl.store(dest + tile * 128 + word, packed)
+
+
+@triton.jit
+def _scales(src, dst, maximum, inv64, perm32, COUNT: tl.constexpr, B: tl.constexpr):
+    i = tl.program_id(0) * B + tl.arange(0, B)
+    raw = i // 32 * 32 + tl.load(perm32 + i % 32)
+    old = raw // 64 * 64 + tl.load(inv64 + raw % 64)
+    s = tl.abs(tl.load(src + old, mask=i < COUNT, other=0).to(tl.float32))
+    mx = tl.maximum(tl.load(maximum), 1e-30)
+    val = tl.extra.cuda.libdevice.nearbyint(s / mx * 4096).to(tl.int16)
+    tl.store(dst + i, val, mask=i < COUNT)
+
+
+@torch.library.custom_op("vllm::turing_marlin_repack", mutates_args=())
+def repack(
+    weight: torch.Tensor, scales: torch.Tensor
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    k = weight.shape[0] * 16
+    n = weight.numel() * 8 // k
+    group = k // scales.shape[0]
+    assert k % 32 == 0 and n % 64 == 0 and group == 128
+    _, _, i64, p32 = _maps(weight.device)
+    positions, columns = _repack_maps(weight.device, n)
+    result = torch.empty_like(weight)
+    quant_scales = torch.empty_like(scales)
+    maximum = scales.float().abs().amax()
+    _repack[(weight.numel() // 128,)](
+        weight, scales, result, positions, columns, N=n, num_warps=4
+    )
+    _scales[(triton.cdiv(scales.numel(), 256),)](
+        scales,
+        quant_scales.view(torch.int16),
+        maximum,
+        i64,
+        p32,
+        COUNT=scales.numel(),
+        B=256,
+        num_warps=4,
+    )
+    return result, quant_scales, maximum / 4096
+
+
+@repack.register_fake
+def _(weight, scales):
+    return (
+        torch.empty_like(weight),
+        torch.empty_like(scales),
+        scales.new_empty((), dtype=torch.float32),
+    )
+
+
+@torch.library.custom_op("vllm::turing_marlin_linear", mutates_args=("workspace",))
+def linear(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    scales: torch.Tensor,
+    zeros: torch.Tensor,
+    g_idx: torch.Tensor,
+    sort: torch.Tensor,
+    workspace: torch.Tensor,
+    size_n: int,
+    size_k: int,
+    is_k_full: bool,
+    bias: torch.Tensor | None,
+    use_fp32_reduce: bool,
+) -> torch.Tensor:
+    # Dispatch INSIDE the opaque op. A Python branch on symbolic M outside it
+    # can specialize a whole vLLM compile range to its profiling shape. Here
+    # capture at M=5 records exactly the original W4A16 kernels, even if the
+    # model was compiled/profiled at M=2048 first.
+    from vllm.scalar_type import scalar_types
+
+    from .marlin_utils import apply_gptq_marlin_linear
+
+    dtype, global_scale = None, None
+    if x.numel() // x.shape[-1] >= 1024:
+        weight, scales, global_scale = repack(weight, scales)
+        dtype = torch.int8
+    return apply_gptq_marlin_linear(
+        x,
+        weight,
+        scales,
+        zeros,
+        g_idx,
+        sort,
+        workspace,
+        scalar_types.uint4b8,
+        size_n,
+        size_k,
+        is_k_full,
+        input_global_scale=global_scale,
+        bias=bias,
+        use_fp32_reduce=use_fp32_reduce,
+        input_dtype=dtype,
+    )
+
+
+@linear.register_fake
+def _(
+    x,
+    weight,
+    scales,
+    zeros,
+    g_idx,
+    sort,
+    workspace,
+    size_n,
+    size_k,
+    is_k_full,
+    bias,
+    use_fp32_reduce,
+):
+    return x.new_empty((*x.shape[:-1], size_n))
