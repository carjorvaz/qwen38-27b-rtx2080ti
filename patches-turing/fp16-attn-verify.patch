+"""SM75 prefill: gather paged KV once, then use native Cutlass FP16 attention.
+
+The generic Triton D=256/GQA prefill spills on Turing (1.36 s versus 72 ms
+for 816 queries over 65K INT8 keys). A shared, pre-profiled FP16 workspace
+avoids both those spills and an unbounded per-layer dequantization allocation.
+Decode and multi-request batches retain their existing paged kernels.
+"""
+import torch
+import triton
+import triton.language as tl
+from torch.nn.attention import SDPBackend, sdpa_kernel
+from torch.nn.attention.bias import causal_lower_right
+from torch.nn.functional import scaled_dot_product_attention
+
+
+@triton.jit
+def _gather_kv(
+    k, v, ks, vs, table, dst_k, dst_v, n,
+    kb, kt, kh, kd, vb, vt, vh, vd,
+    ksb, kst, ksh, vsb, vst, vsh,
+    capacity: tl.constexpr, D: tl.constexpr, BLOCK: tl.constexpr,
+    QUANT: tl.constexpr, ROWS: tl.constexpr,
+):
+    head = tl.program_id(1)
+    pos = tl.program_id(0) * ROWS + tl.arange(0, ROWS)
+    dim = tl.arange(0, D)
+    valid = pos < n
+    block = tl.load(table + pos // BLOCK, mask=valid, other=0)
+    slot = pos % BLOCK
+    kval = tl.load(k + block[:, None] * kb + slot[:, None] * kt
+                   + head * kh + dim[None, :] * kd, mask=valid[:, None], other=0)
+    vval = tl.load(v + block[:, None] * vb + slot[:, None] * vt
+                   + head * vh + dim[None, :] * vd, mask=valid[:, None], other=0)
+    if QUANT:
+        kscale = tl.load(ks + block * ksb + slot * kst + head * ksh, mask=valid, other=0)
+        vscale = tl.load(vs + block * vsb + slot * vst + head * vsh, mask=valid, other=0)
+        kval = kval.to(tl.float32) * kscale[:, None]
+        vval = vval.to(tl.float32) * vscale[:, None]
+    offset = (head * capacity + pos[:, None]) * D + dim[None, :]
+    tl.store(dst_k + offset, kval, mask=valid[:, None])
+    tl.store(dst_v + offset, vval, mask=valid[:, None])
+
+
+class TuringPrefillAttention:
+    def __init__(self, capacity, num_kv_heads, head_dim, device):
+        self.capacity = capacity
+        self.num_kv_heads = num_kv_heads
+        self.head_dim = head_dim
+        self.storage = torch.empty(
+            (2, num_kv_heads, capacity, head_dim), dtype=torch.float16, device=device
+        )
+        self.key, self.value = self.storage.unbind(0)
+        self.shape = None
+
+    def run(self, q, k, v, out, block_table, num_keys, scale,
+            k_scale_cache=None, v_scale_cache=None):
+        num_queries, num_heads, dim = q.shape
+        assert 0 < num_queries <= num_keys <= self.capacity
+        assert dim == self.head_dim and num_heads % self.num_kv_heads == 0
+        assert q.dtype == out.dtype == torch.float16
+        quant = k_scale_cache is not None
+        assert (v_scale_cache is not None) == quant
+        assert k.dtype == v.dtype == (torch.int8 if quant else torch.float16)
+        _gather_kv[(triton.cdiv(num_keys, 16), self.num_kv_heads)](
+            k, v, k_scale_cache, v_scale_cache, block_table,
+            self.key, self.value, num_keys,
+            *k.stride(), *v.stride(),
+            *(k_scale_cache.stride() if quant else (0, 0, 0)),
+            *(v_scale_cache.stride() if quant else (0, 0, 0)),
+            capacity=self.capacity, D=dim, BLOCK=k.shape[1], QUANT=quant,
+            ROWS=16, num_warps=4, num_stages=1,
+        )
+        group = num_heads // self.num_kv_heads
+        shape = (num_queries, num_keys, num_heads)
+        if self.shape != shape:
+            # Zero-stride expansion implements GQA without repeating KV sixfold.
+            self.grouped_key = self.key[:, None, :num_keys].expand(-1, group, -1, -1)
+            self.grouped_value = self.value[:, None, :num_keys].expand(-1, group, -1, -1)
+            self.mask = causal_lower_right(num_queries, num_keys)
+            self.shape = shape
+        grouped_query = q.view(num_queries, self.num_kv_heads, group, dim).permute(1, 2, 0, 3)
+        with sdpa_kernel(SDPBackend.EFFICIENT_ATTENTION):
+            result = scaled_dot_product_attention(
+                grouped_query, self.grouped_key, self.grouped_value,
+                attn_mask=self.mask, scale=scale,
+            )
+        # Cutlass returns grouped BSHD storage. Copy straight into the caller's
+        # output view; do not materialize a second transposed intermediate.
+        out.view(num_queries, self.num_kv_heads, group, dim).permute(1, 2, 0, 3).copy_(result)
+        return out
+
+
+_WORKSPACES = {}
+
+
+def acquire_turing_prefill(capacity, num_kv_heads, head_dim, device):
+    key = (capacity, num_kv_heads, head_dim, device)
+    workspace = _WORKSPACES.get(key)
+    if workspace is None:
+        workspace = TuringPrefillAttention(capacity, num_kv_heads, head_dim, device)
+        _WORKSPACES[key] = workspace
+    return workspace
