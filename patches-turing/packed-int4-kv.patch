+void launch_rht(const at::Tensor &x, const at::Tensor &out,
+                const at::Tensor &signs, bool inverse,
+                const std::optional<at::Tensor> &cuq, int64_t num_reqs) {
+  check_device(x, x, "x");
+  check_device(out, x, "out");
+  check_device(signs, x, "signs");
+  TORCH_CHECK(
+      x.dim() == 3 && out.sizes() == x.sizes() && x.size(2) == kDim &&
+          x.size(1) > 0 && x.stride(2) == 1 && out.stride(2) == 1 &&
+          (x.scalar_type() == at::kHalf || x.scalar_type() == at::kFloat) &&
+          out.scalar_type() == at::kHalf,
+      "RHT requires matching FP16/FP32 input and FP16 output "
+      "[tokens, heads, 256] with last-dimension stride 1");
+  TORCH_CHECK(signs.scalar_type() == at::kFloat && signs.dim() == 1 &&
+                  signs.numel() == kDim && signs.stride(0) == 1,
+              "RHT signs must be a contiguous FP32 D256 vector");
+  const int32_t *lengths = nullptr;
+  int64_t length_stride = 0;
+  if (cuq) {
+    check_device(*cuq, x, "cuq");
+    TORCH_CHECK(cuq->scalar_type() == at::kInt && cuq->dim() == 1 &&
+                    num_reqs >= 0 && num_reqs < cuq->numel() &&
+                    num_reqs <= std::numeric_limits<int32_t>::max(),
+                "RHT cuq must have a live end offset for num_reqs");
+    lengths = cuq->data_ptr<int32_t>();
+    length_stride = cuq->stride(0);
+  }
+  const int64_t rows = x.size(0) * x.size(1);
+  TORCH_CHECK(rows <= int64_t{4} * std::numeric_limits<int32_t>::max(),
+              "RHT launch grid exceeds CUDA's x dimension");
+  if (rows == 0) {
+    return;
+  }
+  const c10::cuda::CUDAGuard guard(x.device());
+  const cudaStream_t stream = c10::cuda::getCurrentCUDAStream(x.get_device());
+  const unsigned int blocks = static_cast<unsigned int>((rows + 3) / 4);
+#define RUN_RHT(TYPE, INV)                                                     \
+  rht_kernel<TYPE, INV><<<blocks, kThreads, 0, stream>>>(                      \
+      static_cast<const TYPE *>(x.data_ptr()),                                 \
+      reinterpret_cast<__half *>(out.data_ptr<at::Half>()),                    \
+      signs.data_ptr<float>(), lengths, length_stride,                         \
+      static_cast<int>(num_reqs), x.size(0), x.size(1), x.stride(0),           \
+      x.stride(1), out.stride(0), out.stride(1))
+  if (x.scalar_type() == at::kHalf) {
+    if (inverse) {
+      RUN_RHT(__half, true);
+    } else {
+      RUN_RHT(__half, false);
+    }
+  } else {
+    if (inverse) {
+      RUN_RHT(float, true);
+    } else {
+      RUN_RHT(float, false);
+    }
+  }
+#undef RUN_RHT
   C10_CUDA_KERNEL_LAUNCH_CHECK();
 }
 
