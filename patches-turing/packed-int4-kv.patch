+// One warp owns a D256 vector. The butterfly is FP32, with the same
+// low-to-high stage order as int4_per_token_head.fast_hadamard_transform.
+// No shared memory, SM80 instructions, or per-token allocation is needed.
+template <typename Input, bool Inverse>
+__global__ void rht_kernel(const Input *x, __half *out, const float *signs,
+                           const int32_t *cuq, int64_t cuq_stride, int num_reqs,
+                           int64_t tokens, int64_t heads, int64_t xt,
+                           int64_t xh, int64_t ot, int64_t oh) {
+  const int lane = threadIdx.x & 31;
+  const int64_t row = static_cast<int64_t>(blockIdx.x) * 4 + threadIdx.x / 32;
+  const int64_t token = row / heads;
+  if (token >= tokens || (cuq && token >= cuq[num_reqs * cuq_stride])) {
+    return; // Whole-warp branch, including all-empty and graph-padded rows.
+  }
+  const int64_t head = row % heads;
+  float values[8];
+#pragma unroll
+  for (int i = 0; i < 8; ++i) {
+    const int dim = i * 32 + lane;
+    if constexpr (std::is_same_v<Input, __half>) {
+      values[i] = __half2float(x[token * xt + head * xh + dim]);
+    } else {
+      values[i] = x[token * xt + head * xh + dim];
+    }
+    if constexpr (!Inverse) {
+      values[i] *= signs[dim];
+    }
+  }
+#pragma unroll
+  for (int step = 1; step < 32; step *= 2) {
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      const float peer = __shfl_xor_sync(0xffffffffu, values[i], step);
+      values[i] = (lane & step) ? peer - values[i] : values[i] + peer;
+    }
+  }
+#pragma unroll
+  for (int step = 1; step < 8; step *= 2) {
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      if ((i & step) == 0) {
+        const float a = values[i];
+        const float b = values[i + step];
+        values[i] = a + b;
+        values[i + step] = a - b;
+      }
+    }
+  }
+#pragma unroll
+  for (int i = 0; i < 8; ++i) {
+    const int dim = i * 32 + lane;
+    if constexpr (Inverse) {
+      values[i] *= signs[dim] / kDim;
+    }
+    out[token * ot + head * oh + dim] = __float2half_rn(values[i]);
+  }
+}
